{
  "name": "npus-usage",
  "version": "1.0.0",
  "description": "A local web dashboard for monitoring NPU usage on remote SSH hosts (Ascend npu-smi).",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tray": "node launch-tray.js",
    "app": "node launch-app.js",
    "test": "node smoke.js && node test-parser.js && node test-proxy.js",
    "gen-icon": "node tools/gen-tray-icon.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ssh2": "^1.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  }
}
